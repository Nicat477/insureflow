# Copy to backend/.env locally. Never commit real credentials.
# Keep JSON mode until you have a dedicated demo Supabase project.
STORAGE_MODE=json
# STORAGE_MODE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DATABASE_CA_FILE=C:/path/to/downloaded/supabase-ca.crt

# Optional account mode (requires auth:init before startup)
AUTH_MODE=legacy
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
